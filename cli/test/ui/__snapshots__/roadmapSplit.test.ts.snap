="0" aria-valuemax="100" aria-valuenow="50" aria-label="Share of rows done"><span style="width:50%"></span></span><span class="rm-pkpi rm-pkpi-pct">50 %</span><span class="rm-pkpi"><span class="rm-pkpi-num">0</span> in progress</span><span class="rm-pkpi tone-block"><span class="rm-pkpi-num">1</span> blocked</span><span class="rm-pkpi"><span class="rm-pkpi-num">1</span> to do</span></span><span class="rm-plan-only">plan only, no runner</span></summary><div class="rm-detail" data-testid="rm-detail"><header data-testid="rm-header"><p class="page-subtitle">2 of 4 phases done</p></header><div class="rm-view" role="group" aria-label="View" data-testid="rm-view"><button type="button" data-testid="rm-view-timeline" aria-pressed="true">Timeline</button><button type="button" data-testid="rm-view-board" aria-pressed="false">Board</button></div><section class="rm-kpis kpi-strip" data-testid="rm-kpis" aria-label="Summary"><div class="kpi-tile"><span class="kpi-label">Phases done</span><span class="kpi-num">2 / 4</span></div><div class="kpi-tile"><span class="kpi-label">In progress</span><span class="kpi-num">0</span><span class="kpi-sub tone-muted">none</span></div></section><section class="rm-section" data-testid="rm-timeline" aria-label="Timeline"><h3 class="flow-h">Timeline</h3><div class="rm-timeline-grid" style="--rm-cols:1"><div class="rm-head-row"><div class="rm-cell rm-head rm-lane">Plan / milestone</div><div class="rm-cell rm-head"><strong>Phases</strong> <span class="chip chip-waiting">in-progress</span><span class="rm-sub">starts first</span></div></div><div class="rm-row"><div class="rm-cell rm-lane">p-side<span class="rm-sub">2/4 done</span></div><div class="rm-cell"><button type="button" class="rm-tile" data-state="done" title="p-side#a1 A1 | ☑"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-circle-check lucide-