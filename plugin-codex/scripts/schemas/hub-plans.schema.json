{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hub plans output",
  "type": "object",
  "required": [
    "schema",
    "source",
    "plans"
  ],
  "properties": {
    "schema": {
      "type": "integer"
    },
    "source": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "fetched_at": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "commit_at": {
      "oneOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    },
    "overlay": {
      "type": "object",
      "required": [
        "state",
        "reason",
        "count"
      ],
      "properties": {
        "state": {
          "enum": [
            "on",
            "off"
          ]
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "count": {
          "type": "integer"
        }
      }
    },
    "done": {
      "description": "Finished plans from origin/<default>:.caddis/plans/done (origin source only). unchanged: the tree equals --done-known.",
      "type": "object",
      "properties": {
        "tree": {
          "type": [
            "string",
            "null"
          ]
        },
        "unchanged": {
          "const": true
        },
        "error": {
          "type": "string"
        },
        "plans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "closed_at": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "phases": {
                "type": "integer"
              },
              "pr": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "error": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "plans": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "path",
              "title",
              "status",
              "feature",
              "tracker",
              "open_rows"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "status": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "feature": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "tracker": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "phase",
                    "status",
                    "state"
                  ],
                  "properties": {
                    "phase": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "todo",
                        "in-progress",
                        "blocked",
                        "done",
                        "moved"
                      ]
                    },
                    "source": {
                      "enum": [
                        "main",
                        "branch"
                      ]
                    }
                  }
                }
              },
              "open_rows": {
                "type": "integer"
              },
              "changed_at": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "Unix time of the last change: the commit time on origin, or the file time in the working tree. null when unknown."
              },
              "overlay": {
                "type": "object",
                "required": [
                  "pr",
                  "draft",
                  "head_ref",
                  "also"
                ],
                "properties": {
                  "pr": {
                    "type": "integer"
                  },
                  "draft": {
                    "type": "boolean"
                  },
                  "head_ref": {
                    "type": "string"
                  },
                  "also": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "path",
              "error"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "error": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
