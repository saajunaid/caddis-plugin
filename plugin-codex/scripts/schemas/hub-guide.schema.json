{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hub guide output",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generated",
    "commands",
    "agents",
    "skills",
    "hooks",
    "coverage",
    "counts"
  ],
  "properties": {
    "schema": {
      "type": "integer"
    },
    "version": {
      "type": "string"
    },
    "generated": {
      "type": "string"
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "hint",
          "steps",
          "scripts",
          "noArgs",
          "stage",
          "daily"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "scripts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "noArgs": {
            "type": "boolean"
          },
          "stage": {
            "type": "string"
          },
          "daily": {
            "type": "boolean"
          }
        }
      }
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "tools",
          "model",
          "writes"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "model": {
            "type": "string"
          },
          "writes": {
            "type": "boolean"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "category",
          "description",
          "core"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "core": {
            "type": "boolean"
          }
        }
      }
    },
    "hooks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "event",
          "matcher",
          "handler"
        ],
        "properties": {
          "event": {
            "type": "string"
          },
          "matcher": {
            "type": "string"
          },
          "handler": {
            "type": "string"
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "commands",
        "skills",
        "agents"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "required": [
        "commands",
        "agents",
        "skills",
        "core",
        "hooks"
      ],
      "properties": {
        "commands": {
          "type": "integer"
        },
        "agents": {
          "type": "integer"
        },
        "skills": {
          "type": "integer"
        },
        "core": {
          "type": "integer"
        },
        "hooks": {
          "type": "integer"
        }
      }
    }
  }
}
