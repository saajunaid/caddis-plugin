{
  "description": "caddis harness loop, auto-activated on install: relay.md session-resume injection (SessionStart + PreCompact), a session-end nudge + token-usage digest (Stop), a subagent dispatch/verdict log for agent-eval (SubagentStop -> .caddis/agent-log.jsonl), post-edit lint (PostToolUse on Edit/Write/MultiEdit), a rules-file budget re-warn (PostToolUse on Edit/Write/MultiEdit to an oversize AGENTS.md/CLAUDE.md), a waiting-for-you mark for the roadmap page (Notification writes .caddis/session-state/<sid>.waiting; UserPromptSubmit, Stop and SessionEnd clear it), and a deterministic safety guard (PreToolUse on Bash/PowerShell/Edit/Write/MultiEdit/Read/Grep) that blocks secret/catastrophic writes, blocks reading or copying onto a secret .env/credential file, and asks before destructive shell/lockfile/CI changes and before writes to caddis config (in deny-only mode every ask becomes allow, so these do not ask there; escape hatch: .caddis/config.toml [guard] allow — write/shell only, it can never unblock a Read or Grep; full off only via CADDIS_GUARD_DISABLED=1 in an interactive session). The guard has a 30 s timeout and onFailure: block (Claude Code v2.1.295+), so a hung or crashed guard blocks the call. All handlers are pure-Python and cross-platform; they require `python` on PATH.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|MultiEdit|Read|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/guard.py\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/doc_header_guard.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_relay.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/repo_freshness.py\"",
            "timeout": 25
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/caddis_statusline.py\" --refresh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/inject_relay.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_end.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_waiting.py\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_log.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/auto_lint.py\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/rules_budget_nudge.py\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_end.py\""
          },
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_waiting.py\""
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_waiting.py\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/session_waiting.py\"",
            "async": true
          }
        ]
      }
    ]
  }
}
