      "marketplace": {
        "name": "caddis",
        "owner": { "name": "junaid" },
        "description": "caddis plugin marketplace",
        "plugins": [
          {"name": "caddis", "source": "./plugin", "description": "caddis — agent-agnostic dev harness: lean subagents, TDD commands, a core dev skill set, loop hooks, and a CLAUDE.md generator."},
          {"name": "caddis-extras", "source": "./plugin-extras", "description": "caddis-extras — the full caddis skill library (cloud, data, the long tail of frontend/coding, media, productivity). Disabled by default; enable on demand to keep always-on context lean."}
