{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flow-studio model",
  "description": "What an author writes. The engine renders it. validate.mjs also enforces rules a schema cannot (unique ids, links that point at real nodes, no overlap, no orphan).",
  "type": "object",
  "required": ["version", "meta", "layout", "columns", "lanes", "states", "nodes", "links"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "meta": {
      "type": "object",
      "required": ["title", "help", "asOf", "source"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string" },
        "help": { "type": "string" },
        "asOf": { "type": "string" },
        "source": { "type": "string" },
        "labels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "layout": { "enum": ["columns-lanes", "free", "auto"] },
    "columns": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "title", "width"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" }, "short": { "type": "string" },
          "width": { "type": "number", "minimum": 60 }, "phase": { "type": "string" }
        }
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "title"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "title": { "type": "string" }, "badge": { "type": "string" },
          "badgeTone": { "enum": ["ok", "warn", "muted"] }, "note": { "type": "string" }, "gap": { "type": "boolean" }
        }
      }
    },
    "states": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["word", "tone", "border", "edge", "motion", "bucket"], "additionalProperties": false,
        "properties": {
          "word": { "type": "string" },
          "tone": { "enum": ["ok", "warn", "crit", "info", "muted", "accent"] },
          "border": { "enum": ["solid", "dashed", "dotted"] },
          "edge": { "enum": ["flow", "dash", "dash-short", "dot"] },
          "motion": { "enum": ["flow", "flow-slow", "breathe", "none"] },
          "bucket": { "enum": ["good", "neutral", "gap"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "kind", "state", "title"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["card", "group", "chip", "gateway", "start", "end", "event", "placeholder", "note"] },
          "lane": { "type": "string" }, "col": { "type": "integer", "minimum": 0 }, "colSpan": { "type": "integer", "minimum": 1 },
          "row": { "type": "number" }, "x": { "type": "number" }, "y": { "type": "number" },
          "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 },
          "state": { "type": "string" },
          "stateIn": { "type": "object", "additionalProperties": { "type": "string" } },
          "visibleIn": { "type": "array", "items": { "type": "string" } },
          "title": { "type": "string" }, "subtitle": { "type": "string" },
          "members": { "type": "array", "items": { "type": "string" } },
          "weight": { "type": "number", "minimum": 0 }, "ref": { "type": "string" },
          "upgrade": { "type": "string" }, "allowIsolated": { "type": "boolean" },
          "contains": { "type": "array", "items": { "type": "string" } }, "collapsed": { "type": "boolean", "default": true, "description": "A group with contains starts collapsed unless collapsed is false." },
          "sla": { "type": "number", "exclusiveMinimum": 0, "description": "Target service level agreement in seconds" },
          "metrics": { "type": "object", "required": ["value"], "additionalProperties": false,
            "properties": { "value": { "type": "number" }, "max": { "type": ["number", "null"], "description": "Upper bound for the badge fill bar; null means there is no maximum" }, "unit": { "type": "string" }, "label": { "type": "string" },
              "series": { "type": "array", "maxItems": 60, "items": { "type": "number" } } } }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "from", "to", "state"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" }, "state": { "type": "string" },
          "stateIn": { "type": "object", "additionalProperties": { "type": "string" } },
          "visibleIn": { "type": "array", "items": { "type": "string" } }, "label": { "type": "string" },
          "kind": { "enum": ["forward", "loop-back"] }
        }
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "label"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "default": { "type": "boolean" } }
      }
    },
    "inspector": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "relations": {
          "type": "array", "maxItems": 3,
          "items": {
            "type": "object", "required": ["id", "label", "dir"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string" }, "label": { "type": "string" }, "dir": { "enum": ["up", "down"] },
              "filter": { "type": "object", "additionalProperties": false, "properties": { "col": { "type": "integer" }, "kind": { "type": "string" } } }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "label", "dir", "staleText"], "additionalProperties": false,
            "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "dir": { "const": "down" }, "staleText": { "type": "string" } }
          }
        }
      }
    },
    "scenarios": { "type": "array", "items": { "type": "object", "required": ["id", "label", "steps"], "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "label": { "type": "string" },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["link"], "additionalProperties": false,
          "properties": { "link": { "type": "string" }, "at": { "type": "number", "minimum": 0, "description": "Relative elapsed offset from scenario start in seconds" }, "dur": { "type": "number", "exclusiveMinimum": 0, "description": "Token travel animation duration in milliseconds (defaults to 900)" }, "caption": { "type": "string" } } } } } } },
    "notes": {
      "type": "array",
      "items": {
        "type": "object", "required": ["anchor", "title", "text"], "additionalProperties": false,
        "properties": { "anchor": { "type": "string" }, "title": { "type": "string" }, "text": { "type": "string" } }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "layout": { "const": "columns-lanes" } } },
      "then": { "properties": { "columns": { "minItems": 1 }, "lanes": { "minItems": 1 },
        "nodes": { "items": { "required": ["lane", "col", "row"] } } } } },
    { "if": { "properties": { "layout": { "const": "free" } } },
      "then": { "properties": { "lanes": { "minItems": 1 }, "nodes": { "items": { "required": ["lane", "x", "y"] } } } } }
  ]
}
