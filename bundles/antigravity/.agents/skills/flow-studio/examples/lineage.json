  "notes": [
    {
      "anchor": "#layerstrip",
      "title": "Completeness strip",
      "text": "One cell per column: a stacked bar (good, neutral, gap) and 'known / recorded'. Data: node weights by state bucket. An empty column shows a dotted track, never a full bar."
    },
    {
      "anchor": "#kpis",
      "title": "Summary tiles",
      "text": "Links by state bucket, groups with a gap, and groups that can be improved. The last two are buttons that dim everything else (aria-pressed)."
    },
    {
      "anchor": "#modeSwitch",
      "title": "View switch",
      "text": "Today shows what the current page can record. Complete adds the declared layer. Both views come from one model: visibleIn and stateIn decide what each view shows."
    },
    {
      "anchor": "#viewport",
      "title": "Canvas",
      "text": "Wheel zooms around the cursor, drag pans, double-click fits. The first view fits the width (zoom 0.6 or more); 0 fits everything."
    },
    {
      "anchor": "#tools",
      "title": "Canvas controls",
      "text": "Select, hand, zoom in and out, fit, 100 percent, zoom to selection and fullscreen. Keys: V H + - 0 1 F and the arrows."
    },
    {
      "anchor": "#inspector",
      "title": "Inspector",
      "text": "Slides in on a click and closes with Esc. The three buttons highlight the groups that feed this one, the groups downstream, and the last column. The red button simulates a failure."
    }
  ]
