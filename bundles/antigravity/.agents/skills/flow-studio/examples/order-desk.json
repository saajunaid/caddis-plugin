{
  "version": 1,
  "meta": {
    "title": "ORDER DESK: FROM REQUEST TO CLOSE",
    "help": "Follow a fictional order from intake to close. Open the fulfilment group to see its tasks. A request for more details returns to verification.",
    "asOf": "2026-10-05",
    "source": "Fictional Order desk example. No live orders or customer records are used."
  },
  "layout": "auto",
  "columns": [
    { "id": "intake", "title": "Intake", "width": 150 },
    { "id": "verify", "title": "Verify", "width": 150 },
    { "id": "route", "title": "Route", "width": 150 },
    { "id": "prepare", "title": "Prepare", "width": 150 },
    { "id": "tasks", "title": "Tasks", "width": 150 },
    { "id": "fulfil", "title": "Fulfil", "width": 150 },
    { "id": "update", "title": "Update", "width": 150 },
    { "id": "close", "title": "Close", "width": 150 }
  ],
  "lanes": [
    { "id": "desk", "title": "Order desk" },
    { "id": "checks", "title": "Checks" },
    { "id": "fulfilment", "title": "Fulfilment" }
  ],
  "states": {
    "ready": { "word": "READY", "tone": "ok", "border": "solid", "edge": "flow", "motion": "flow", "bucket": "good" },
    "waiting": { "word": "WAITING", "tone": "warn", "border": "dashed", "edge": "dash", "motion": "flow-slow", "bucket": "neutral" },
    "review": { "word": "REVIEW", "tone": "info", "border": "solid", "edge": "dash-short", "motion": "flow-slow", "bucket": "neutral" }
  },
  "nodes": [
    { "id": "intake", "kind": "start", "lane": "desk", "state": "ready", "title": "New request" },
    { "id": "verify", "kind": "card", "lane": "desk", "state": "review", "title": "Verify details" },
    { "id": "route", "kind": "gateway", "lane": "desk", "state": "review", "title": "Ready?" },
    { "id": "hold", "kind": "card", "lane": "desk", "state": "waiting", "title": "Ask for details", "sla": 60 },
    { "id": "quote", "kind": "card", "lane": "desk", "state": "ready", "title": "Confirm terms" },
    { "id": "stock", "kind": "card", "lane": "checks", "state": "review", "title": "Check stock", "metrics": { "label": "Items ready", "value": 8, "max": 10, "unit": "items", "series": [2, 3, 5, 5, 7, 8] } },
    { "id": "payment", "kind": "card", "lane": "checks", "state": "review", "title": "Check payment", "metrics": { "label": "Checks", "value": 4, "max": 5 } },
    { "id": "fulfil-group", "kind": "group", "lane": "fulfilment", "col": 5, "state": "ready", "title": "Prepare parcel", "contains": ["pick", "pack", "dispatch"] },
    { "id": "pick", "kind": "card", "lane": "fulfilment", "state": "ready", "title": "Pick items" },
    { "id": "pack", "kind": "card", "lane": "fulfilment", "state": "ready", "title": "Pack items" },
    { "id": "dispatch", "kind": "card", "lane": "fulfilment", "state": "ready", "title": "Dispatch", "metrics": { "label": "Parcels", "value": 3, "unit": "sent" } },
    { "id": "notify", "kind": "card", "lane": "desk", "state": "ready", "title": "Send update" },
    { "id": "receipt", "kind": "card", "lane": "desk", "state": "ready", "title": "File receipt" },
    { "id": "close", "kind": "end", "lane": "desk", "state": "ready", "title": "Close order" }
  ],
  "links": [
    { "id": "l-intake-verify", "from": "intake", "to": "verify", "state": "ready" },
