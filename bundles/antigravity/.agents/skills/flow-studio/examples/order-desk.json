    { "id": "l-quote-payment", "from": "quote", "to": "payment", "state": "review" },
    { "id": "l-quote-pick", "from": "quote", "to": "pick", "state": "ready" },
    { "id": "l-quote-pack", "from": "quote", "to": "pack", "state": "ready" },
    { "id": "l-stock-dispatch", "from": "stock", "to": "dispatch", "state": "review" },
    { "id": "l-payment-dispatch", "from": "payment", "to": "dispatch", "state": "review" },
    { "id": "l-pick-dispatch", "from": "pick", "to": "dispatch", "state": "ready" },
    { "id": "l-pack-dispatch", "from": "pack", "to": "dispatch", "state": "ready" },
    { "id": "l-dispatch-notify", "from": "dispatch", "to": "notify", "state": "ready" },
    { "id": "l-dispatch-receipt", "from": "dispatch", "to": "receipt", "state": "ready" },
    { "id": "l-notify-close", "from": "notify", "to": "close", "state": "ready" },
    { "id": "l-receipt-close", "from": "receipt", "to": "close", "state": "ready" }
  ],
  "scenarios": [
    { "id": "happy", "label": "Happy path", "steps": [
      { "link": "l-intake-verify", "at": 0, "caption": "Request reaches verification" },
      { "link": "l-verify-route", "at": 10, "caption": "Details are checked" },
      { "link": "l-route-quote", "at": 20, "caption": "Ready to confirm terms" },
      { "link": "l-quote-stock", "at": 30, "caption": "Stock is checked" },
      { "link": "l-stock-dispatch", "at": 40, "caption": "Parcel is dispatched" },
      { "link": "l-dispatch-notify", "at": 50, "caption": "An update is sent" },
      { "link": "l-notify-close", "at": 60, "caption": "Order is closed" }
    ] },
    { "id": "escalated", "label": "Escalated", "steps": [
      { "link": "l-intake-verify", "at": 0, "caption": "Request reaches verification" },
      { "link": "l-verify-route", "at": 20, "caption": "Details need review" },
      { "link": "l-route-hold", "at": 90, "caption": "More details are needed" },
      { "link": "l-hold-verify", "at": 120, "caption": "Details arrive" },
      { "link": "l-verify-route", "at": 140, "caption": "Details are checked again" },
      { "link": "l-route-quote", "at": 150, "caption": "Terms can proceed" },
      { "link": "l-quote-stock", "at": 160, "caption": "Stock is checked" },
      { "link": "l-stock-dispatch", "at": 170, "caption": "Parcel is dispatched" },
      { "link": "l-dispatch-notify", "at": 180, "caption": "An update is sent" },
      { "link": "l-notify-close", "at": 190, "caption": "Order is closed" }
    ] }
  ],
  "inspector": {
    "relations": [
      { "id": "up", "label": "Came from", "dir": "up" },
      { "id": "down", "label": "Goes to", "dir": "down" },
      { "id": "closed", "label": "Closed", "dir": "down", "filter": { "kind": "end" } }
    ]
  },
  "notes": [
    { "anchor": "#n_route", "title": "A decision with named exits", "text": "The desk either asks for more details or confirms the order can move on." },
    { "anchor": "#n_fulfil-group", "title": "A group that can open", "text": "The parcel preparation tasks are folded into one node until the reader opens the group." }
  ]
}
