{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "sh -c 'echo CADDIS-HOOK-FIRED >> $HOME/.caddis-agy-hook.log'",
        "windows": "cmd /c echo CADDIS-HOOK-FIRED>>%USERPROFILE%\\.caddis-agy-hook.log",
        "linux": "sh -c 'echo CADDIS-HOOK-FIRED >> $HOME/.caddis-agy-hook.log'",
        "osx": "sh -c 'echo CADDIS-HOOK-FIRED >> $HOME/.caddis-agy-hook.log'"
      }
    ]
  }
}
