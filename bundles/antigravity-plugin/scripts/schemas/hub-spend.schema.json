{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hub spend output",
  "type": "object",
  "required": [
    "schema",
    "configured",
    "cap_eur",
    "committed_eur",
    "reserve_eur",
    "window_h"
  ],
  "properties": {
    "schema": {
      "type": "integer"
    },
    "configured": {
      "type": "boolean"
    },
    "cap_eur": {
      "type": [
        "number",
        "null"
      ]
    },
    "committed_eur": {
      "type": "number"
    },
    "reserve_eur": {
      "type": [
        "number",
        "null"
      ]
    },
    "window_h": {
      "type": "integer"
    }
  }
}
